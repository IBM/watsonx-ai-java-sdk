<?xml version="1.0" encoding="UTF-8"?>
<project
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <name>watsonx-ai-jackson3</name>
  <artifactId>watsonx-ai-jackson3</artifactId>
  <url>https://github.com/IBM/watsonx-ai-java-sdk</url>

  <description>
  Jackson 3 JSON binding for the watsonx.ai SDK. Provides a JsonProvider implementation
  backed by Jackson 3.
  </description>

  <scm>
    <connection>scm:git:git://github.com/IBM/watsonx-ai-java-sdk.git</connection>
    <developerConnection>scm:git:ssh://github.com/IBM/watsonx-ai-java-sdk.git</developerConnection>
    <url>https://github.com/IBM/watsonx-ai-java-sdk</url>
  </scm>

  <parent>
    <groupId>com.ibm.watsonx</groupId>
    <artifactId>watsonx-ai-parent</artifactId>
    <version>999-SNAPSHOT</version>
    <relativePath>../..</relativePath>
  </parent>

  <dependencies>
    <dependency>
      <groupId>com.ibm.watsonx</groupId>
      <artifactId>watsonx-ai-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.ibm.watsonx</groupId>
      <artifactId>watsonx-ai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ibm.watsonx</groupId>
      <artifactId>watsonx-ai</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.weld</groupId>
      <artifactId>weld-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${maven-dependency-plugin-version}</version>
        <executions>
          <execution>
            <id>unpack-shared-tests</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeArtifactIds>watsonx-ai</includeArtifactIds>
              <includeTypes>test-jar</includeTypes>
              <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>unpack-shared-tests</id>
                <configuration>
                  <!--
                    Tests that rely on Mockito, WireMock, or the CDI container (Weld) are excluded
                    because those frameworks are not compatible with native-image. This mirrors the
                    testExcludes in watsonx-ai's own native profile: the shared tests here arrive as
                    precompiled classes unpacked from watsonx-ai's test-jar, so maven-compiler-plugin
                    excludes don't apply and the exclusion has to happen at unpack time instead.
                  -->
                  <excludes>**/AbstractWatsonxTest.class,**/AbstractWatsonxTest$*.class,**/BatchServiceTest.class,**/BatchServiceTest$*.class,**/CustomHttpClientTest.class,**/CustomHttpClientTest$*.class,**/DeploymentServiceTest.class,**/DeploymentServiceTest$*.class,**/DetectionServiceTest.class,**/DetectionServiceTest$*.class,**/EmbeddingServiceTest.class,**/EmbeddingServiceTest$*.class,**/FileServiceTest.class,**/FileServiceTest$*.class,**/RerankServiceTest.class,**/RerankServiceTest$*.class,**/TextGenerationServiceTest.class,**/TextGenerationServiceTest$*.class,**/TokenizationServiceTest.class,**/TokenizationServiceTest$*.class,**/ToolServiceTest.class,**/ToolServiceTest$*.class,**/ContextDepedencyInjectionTest.class,**/ContextDepedencyInjectionTest$*.class,**/ChatMessageTest.class,**/ChatMessageTest$*.class,**/ChatRequestTest.class,**/ChatRequestTest$*.class,**/ChatServiceStreamingTest.class,**/ChatServiceStreamingTest$*.class,**/ChatServiceTest.class,**/ChatServiceTest$*.class,**/ChatServiceThinkingTest.class,**/ChatServiceThinkingTest$*.class,**/ChatStreamingCancellationTest.class,**/ChatStreamingCancellationTest$*.class,**/ToolRegistryTest.class,**/ToolRegistryTest$*.class,**/CustomRestClientTest.class,**/CustomRestClientTest$*.class,**/DeploymentStreamingCancellationTest.class,**/DeploymentStreamingCancellationTest$*.class,**/FoundationModelServiceTest.class,**/FoundationModelServiceTest$*.class,**/ModelGatewayCatalogServiceTest.class,**/ModelGatewayCatalogServiceTest$*.class,**/ModelGatewayChatServiceTest.class,**/ModelGatewayChatServiceTest$*.class,**/ModelGatewayChatStreamingCancellationTest.class,**/ModelGatewayChatStreamingCancellationTest$*.class,**/ModelGatewayEmbeddingServiceTest.class,**/ModelGatewayEmbeddingServiceTest$*.class,**/ModelGatewayImageServiceTest.class,**/ModelGatewayImageServiceTest$*.class,**/TextGenerationStreamingCancellationTest.class,**/TextGenerationStreamingCancellationTest$*.class,**/ClusterSchemaTest.class,**/ClusterSchemaTest$*.class,**/CreateSchemaTest.class,**/CreateSchemaTest$*.class,**/ImproveSchemaTest.class,**/ImproveSchemaTest$*.class,**/MergeSchemaTest.class,**/MergeSchemaTest$*.class,**/TextClassificationTest.class,**/TextClassificationTest$*.class,**/TextExtractionTest.class,**/TextExtractionTest$*.class,**/TimeSeriesServiceTest.class,**/TimeSeriesServiceTest$*.class,**/PaginationTest.class,**/PaginationTest$*.class,**/StreamingUtilsTest.class,**/StreamingUtilsTest$*.class</excludes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-agent</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <agent>
                <enabled>true</enabled>
                <options>
                  <callerFilterFiles>
                    <filterFile>${project.basedir}/native-agent-filter.json</filterFile>
                  </callerFilterFiles>
                  <accessFilterFiles>
                    <filterFile>${project.basedir}/native-agent-filter.json</filterFile>
                  </accessFilterFiles>
                </options>
                <metadataCopy>
                  <merge>false</merge>
                  <outputDirectory>${project.basedir}/src/main/resources/META-INF/native-image/com.ibm.watsonx/${project.artifactId}</outputDirectory>
                  <disabledStages>
                    <stage>main</stage>
                  </disabledStages>
                </metadataCopy>
              </agent>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
